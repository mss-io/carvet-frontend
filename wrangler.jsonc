// See docs/cloudflare-deploy.md for how this Worker is built and deployed.
{
  "name": "carvet",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  // Required by `npx wrangler preview` (Cloudflare preview builds for non-main branches). Can stay empty:
  // assets and compatibility settings are inherited from the top level.
  "previews": {}
}
